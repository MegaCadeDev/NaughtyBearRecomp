 #define g_HalfPixelOffset          vk::RawBufferLoad<float2>(g_PushConstants.SharedConstants + 264)
 #define g_AlphaThreshold           vk::RawBufferLoad<float>(g_PushConstants.SharedConstants + 272)
 
+// Vertex fetches indexed by a computed register (not the vertex index), such as bone
+// palettes: the runtime gives each vertex input location its stream's decoded data
+// ({ address, stride, offset } from shared constants + 288), one float4 per element.
+float4 vfetchIndexed(uint location, float index, bool rounded)
+{
+    uint64_t entry = g_PushConstants.SharedConstants + 288 + location * 16;
+    uint64_t address = vk::RawBufferLoad<uint64_t>(entry);
+    if (address == 0)
+        return 0.0;
+    uint stride = vk::RawBufferLoad<uint>(entry + 8);
+    uint offset = vk::RawBufferLoad<uint>(entry + 12);
+    uint element = uint(max(rounded ? round(index) : floor(index), 0.0));
+    return vk::RawBufferLoad<float4>(address + uint64_t(element) * stride + offset, 4);
+}
+
