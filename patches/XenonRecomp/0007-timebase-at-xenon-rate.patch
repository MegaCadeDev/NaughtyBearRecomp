+// The Xenon timebase ticks at 49.875 MHz (the rate KeQueryPerformanceFrequency reports),
+// so derive it from the host clock rather than the host's cycle counter.
+inline uint64_t __mftb()
+{
+    constexpr uint64_t TIMEBASE_HZ = 49875000;
+    const uint64_t ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    return (ns / 1000000000) * TIMEBASE_HZ + (ns % 1000000000) * TIMEBASE_HZ / 1000000000;
+}
